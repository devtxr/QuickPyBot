# Telegram
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN

# MongoDB Atlas
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/payment_gateway

# Public URL of this Render service, no trailing slash
PUBLIC_API_URL=https://your-app.onrender.com

# Existing Cloudflare Worker
PAYTM_WORKER_URL=https://paytm-v2.codescan.workers.dev

# 32-byte key encoded as 64 hex characters.
# Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=PASTE_64_HEX_CHARACTERS_HERE

PORT=10000
